{
  "name": "cf-extension",
  "displayName": "Конструктор 1С",
  "description": "Дерево метаданных 1С, поиск объектов, редактирование свойств и модулей в VS Code.",
  "version": "0.3.1",
  "publisher": "RunetX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RunetX/cf-extension"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onView:cfExtension.metadata",
    "onView:cfExtension.properties",
    "onCommand:cfExtension.open"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bsl",
        "aliases": [
          "BSL",
          "Модуль 1С"
        ],
        "mimetypes": [
          "text/x-bsl"
        ]
      }
    ],
    "grammars": [
      {
        "language": "bsl",
        "scopeName": "source.bsl",
        "path": "./syntaxes/bsl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "title": "Конструктор: Открыть конфигурацию",
        "icon": "$(folder-open)",
        "command": "cfExtension.open"
      },
      {
        "title": "Конструктор: Сохранить",
        "icon": "$(save)",
        "command": "cfExtension.save"
      },
      {
        "command": "cfExtension.saveAs",
        "title": "Конструктор: Сохранить как / XML"
      },
      {
        "title": "Конструктор: Поиск объекта",
        "icon": "$(search)",
        "command": "cfExtension.search"
      },
      {
        "command": "cfExtension.findReferences",
        "title": "Конструктор: Найти ссылки GUID"
      },
      {
        "command": "cfExtension.composition",
        "title": "Конструктор: Состав объекта"
      },
      {
        "command": "cfExtension.select",
        "title": "Конструктор: Свойства"
      },
      {
        "command": "cfExtension.close",
        "title": "Конструктор: Закрыть конфигурацию"
      }
    ],
    "configuration": {
      "title": "Конструктор",
      "properties": {
        "cfExtension.serverPath": {
          "type": "string",
          "default": "",
          "description": "Явный путь к model-server для разработки"
        },
        "cfExtension.platformPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "restricted": true,
          "description": "Каталог bin установленной 1С (или каталог её версии) для оригинальных значков. Пустое значение — автоматический поиск. Без платформы используются SVG."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "title": "Конструктор",
          "icon": "media/constructor.svg",
          "id": "cfExtension"
        }
      ]
    },
    "views": {
      "cfExtension": [
        {
          "id": "cfExtension.metadata",
          "name": "Метаданные"
        },
        {
          "name": "Свойства",
          "id": "cfExtension.properties",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "contents": "Откройте конфигурацию CF, CFE, EPF или XML.\n\n[Открыть конфигурацию](command:cfExtension.open)",
        "view": "cfExtension.metadata",
        "when": "!cfExtension.loaded"
      }
    ],
    "menus": {
      "view/title": [
        {
          "when": "view == cfExtension.metadata",
          "group": "navigation",
          "command": "cfExtension.open"
        },
        {
          "when": "view == cfExtension.metadata && cfExtension.loaded",
          "group": "navigation",
          "command": "cfExtension.save"
        },
        {
          "when": "view == cfExtension.metadata && cfExtension.loaded",
          "group": "navigation",
          "command": "cfExtension.search"
        }
      ],
      "view/item/context": [
        {
          "command": "cfExtension.findReferences",
          "when": "view == cfExtension.metadata && viewItem == metadata"
        },
        {
          "command": "cfExtension.composition",
          "when": "view == cfExtension.metadata && viewItem == metadata"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "test:host": "npm run compile && node out/test/host-runner.js"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/vscode": "~1.95.0",
    "@types/node": "^22.0.0",
    "@vscode/test-electron": "^2.0.0",
    "@vscode/vsce": "^3.0.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Доступ к локальным файлам требует доверия рабочей области."
    }
  },
  "icon": "media/logo-k.png"
}
